# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Module the `flask` CLI loads the app from.
FLASK_APP=wsgi.py

# Picks the config class in app/config.py: development, testing or production.
# Defaults to production when unset, so debug is never on by accident.
FLASK_ENV=development

# Turns on the reloader and debugger for `flask run`. The CLI reads this itself,
# not the config class. Must be 0 (or absent) in production.
FLASK_DEBUG=1

# Signs sessions and cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLAlchemy URL for MySQL 8.4 via the PyMySQL driver.
DATABASE_URL=mysql+pymysql://course_finder:change-me@127.0.0.1:3306/course_finder?charset=utf8mb4
